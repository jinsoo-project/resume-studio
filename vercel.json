{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/((?!portfolio|mkt/portfolio|ax|mkt-console|pf-img/|pf-doc/|og/portfolio\\.jpg|templates\\.js|cloud\\.js|config\\.js|view\\.js).*)",
      "has": [
        {
          "type": "host",
          "value": "kimjinsoo-mkt-ax.vercel.app"
        }
      ],
      "destination": "/portfolio",
      "permanent": false
    },
    {
      "source": "/architecture-blueprint(\\.html)?",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/dashboard-blueprint(\\.html)?",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/references(\\.html)?",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/remember(\\.html)?",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wanted(\\.html)?",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/index(\\.html)?",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/PORTFOLIO\\.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/README\\.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/projects/(.*)\\.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/supabase/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/og/og-portfolio(\\.html)?",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/vercel\\.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/\\.gitignore",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/studio.html",
      "permanent": false
    },
    {
      "source": "/:slug/projects-airbridge",
      "destination": "/:slug/projects",
      "permanent": false
    },
    {
      "source": "/p/:slug/projects-airbridge",
      "destination": "/p/:slug/projects",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/portfolio/projects",
      "destination": "/portfolio"
    },
    {
      "source": "/portfolio/projects-test",
      "destination": "/portfolio"
    },
    {
      "source": "/portfolio/projects/test",
      "destination": "/portfolio"
    },
    {
      "source": "/mkt/portfolio",
      "destination": "/portfolio"
    },
    {
      "source": "/mkt/portfolio/projects",
      "destination": "/portfolio"
    },
    {
      "source": "/mkt/portfolio/projects-test",
      "destination": "/portfolio"
    },
    {
      "source": "/r/:slug",
      "destination": "/view?slug=:slug"
    },
    {
      "source": "/p/:slug",
      "destination": "/view?slug=:slug"
    },
    {
      "source": "/p/:slug/projects",
      "destination": "/view"
    },
    {
      "source": "/r/:slug/projects",
      "destination": "/view"
    },
    {
      "source": "/:slug/projects",
      "destination": "/view"
    },
    {
      "source": "/p/:slug/projects-test",
      "destination": "/view"
    },
    {
      "source": "/:slug/projects-test",
      "destination": "/view"
    },
    {
      "source": "/:slug/projects/test",
      "destination": "/view"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "resume-custom-studio.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
